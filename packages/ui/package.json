{
  "name": "@utopia/ui",
  "version": "0.1.0",
  "description": "utopia_ui —— 无样式负担的 UI 原语：CSS Variables 一键换肤（深色/浅色/液态玻璃），零运行时依赖",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./theme": { "types": "./dist/theme.d.ts", "import": "./dist/theme.js" },
    "./html": { "types": "./dist/html.d.ts", "import": "./dist/html.js" },
    "./css": "./css/utopia.css"
  },
  "files": ["dist", "css"],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  }
}
